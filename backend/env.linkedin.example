# LinkedIn OAuth (add these to your .env)
# Used by the backend as the OAuth callback for the Flutter app.

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Backend callback URL – must match exactly what is registered in LinkedIn Developer Portal.
LINKEDIN_REDIRECT_URI=https://api.influence-me.in/auth/linkedin/callback

# Where to send the user after the callback (with ?code=...&state=...). Default below.
LINKEDIN_APP_REDIRECT=influenceme://auth/linkedin/callback

# --- LinkedIn Developer Portal ---
# In your app (client ID 86k9svms1x15bq), add these as Authorized redirect URLs:
#   - https://api.influence-me.in/auth/linkedin/callback   (required for backend callback)
#   - influenceme://auth/linkedin/callback                 (only if using app deep link)

# --- Flutter run ---
# Run the Flutter app with:
#   flutter run --dart-define=LINKEDIN_CLIENT_ID=86k9svms1x15bq --dart-define=LINKEDIN_CLIENT_SECRET=...
# The Flutter app default LINKEDIN_REDIRECT_URI (in auth_repo.dart) should match LINKEDIN_REDIRECT_URI above.
# To use the deep link, pass LINKEDIN_REDIRECT_URI=influenceme://auth/linkedin/callback and add that URL in the LinkedIn portal.
