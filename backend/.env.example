# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb+srv://kumarroopesh754:7xWCjKL8t6Q6QRFA@cluster0.imabisz.mongodb.net/test

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# Firebase (Firestore, Storage, etc.)
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional: default bucket for Storage (defaults to project-id.appspot.com)
# FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_CLIENT_ID=your_client_id
# File Storage Microservice
FILE_STORAGE_BASE_URL=https://files.influence-me.in
FILE_STORAGE_API_KEY=your_api_key_here
FILE_STORAGE_PROJECT_ID=influenceme

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=InfluenceMe
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# Meta OAuth (optional split config for Instagram/Facebook login)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_REDIRECT_URI=https://api.influence-me.in/auth/callback
# Optional Business Login configuration id (Meta dialog/oauth config_id)
INSTAGRAM_CONFIG_ID=your_instagram_config_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://api.influence-me.in/auth/callback
# Backward-compatible alias used in some older environments
CONFIGURATION_KEY=your_instagram_config_id
META_APP_REDIRECT=influenceme://auth/success
# Proactive token refresh buffer (days before expiry)
META_TOKEN_REFRESH_BUFFER_DAYS=3

# LinkedIn OAuth (for Flutter app; add these to .env)
# See backend/env.linkedin.example for full docs and LinkedIn Developer Portal setup.
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://api.influence-me.in/auth/linkedin/callback
LINKEDIN_APP_REDIRECT=influenceme://auth/linkedin/callback
