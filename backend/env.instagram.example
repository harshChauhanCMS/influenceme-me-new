# Instagram + Facebook OAuth (add these to your .env)
# Create app(s) at https://developers.facebook.com and configure Facebook Login.

PORT=5000

# Instagram app config (preferred)
INSTAGRAM_APP_ID=YOUR_INSTAGRAM_APP_ID
INSTAGRAM_APP_SECRET=YOUR_INSTAGRAM_APP_SECRET
INSTAGRAM_REDIRECT_URI=https://yourdomain.com/auth/callback
# Optional Business Login configuration id (Meta config_id).
# Required when your app uses a specific Business Login configuration.
INSTAGRAM_CONFIG_ID=YOUR_INSTAGRAM_CONFIG_ID

# Facebook app config (preferred)
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET
FACEBOOK_REDIRECT_URI=https://yourdomain.com/auth/callback

# Optional shared fallback config (used when platform-specific vars are missing)
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_SECRET
REDIRECT_URI=https://yourdomain.com/auth/callback
# Backward-compatible alias used by some existing deployments.
CONFIGURATION_KEY=YOUR_INSTAGRAM_CONFIG_ID

# Mobile deep link after successful OAuth callback
# Redirect format: influenceme://auth/success?token=ACCESS_TOKEN&type=instagram|facebook
META_APP_REDIRECT=influenceme://auth/success
# Proactive refresh window in days (refresh token before it actually expires)
META_TOKEN_REFRESH_BUFFER_DAYS=3

# Legacy variable retained for backward compatibility in older code paths.
INSTAGRAM_APP_REDIRECT=influenceme://auth/success
