# YouTube OAuth (add these to your .env)
# See YOUTUBE_BACKEND_IMPLEMENTATION.md in the Flutter repo for Google Cloud setup.

YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REDIRECT_URI=https://api.influence-me.in/auth/youtube/callback

# App deep link after OAuth (redirect to Flutter app)
YOUTUBE_APP_REDIRECT_SCHEME=influenceme
YOUTUBE_APP_REDIRECT_HOST=youtube
YOUTUBE_APP_REDIRECT_PATH=connected

# Firestore (for storing YouTube tokens). Required for YouTube token storage.
# 1. Create a Firestore database in your GCP project: Firebase Console → Firestore → Create database (Native mode).
# 2. Project ID (if not in credentials): GCLOUD_PROJECT=your-gcp-project-id
# 3. Auth: path to service account JSON with Firestore permissions.
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
